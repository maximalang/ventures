{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/agent_manifest.schema.json",
  "title": "Agent manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "product_id", "owner_profile", "purpose", "trigger", "source_refs", "knowledge_revision", "allowed_tool_refs", "capability_refs", "budget_ref", "eval_suite_ref", "model_policy_ref", "ttl_review_at", "lifecycle_state"],
  "properties": {
    "schema_version": {"const": "agent_manifest/v1"},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 240},
    "product_id": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/slug"},
    "owner_profile": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/stable_id"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "trigger": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/reference"}},
    "knowledge_revision": {"type": "integer", "minimum": 0},
    "allowed_tool_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/reference"}},
    "capability_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/reference"}},
    "budget_ref": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/reference"},
    "eval_suite_ref": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/reference"},
    "model_policy_ref": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/reference"},
    "ttl_review_at": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/utc_timestamp"},
    "lifecycle_state": {"enum": ["proposed", "sandbox", "evaluated", "pilot", "active", "paused", "retired"]},
    "can_spawn_agents": {"const": false, "default": false, "description": "Recursive spawning is forbidden in v1."}
  }
}
