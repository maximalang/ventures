{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/agent_change.schema.json",
  "title": "Agent change request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "product_id", "agent_id", "requested_transition", "manifest_hash", "expected_revision", "idempotency_key", "decision_ref", "evaluation_ref", "capability_refs"],
  "properties": {
    "schema_version": {"const": "agent_change/v1"},
    "change_id": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/stable_id"},
    "product_id": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/slug"},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 240},
    "requested_transition": {"$ref": "#/$defs/requested_transition"},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "decision_ref": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/reference"},
    "evaluation_ref": {"type": ["string", "null"], "minLength": 1},
    "capability_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://maximalang.github.io/ventures/contracts/adaptive_org/v1/common.schema.json#/$defs/reference"}}
  },
  "$defs": {
    "requested_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "from_state", "to_state"],
      "properties": {
        "operation": {"enum": ["validate", "plan", "apply", "verify", "pause", "retire"]},
        "from_state": {"enum": ["proposed", "sandbox", "evaluated", "pilot", "active", "paused", "retired"]},
        "to_state": {"enum": ["proposed", "sandbox", "evaluated", "pilot", "active", "paused", "retired"]},
        "dry_run": {"type": "boolean", "default": true, "description": "Consumers MUST treat an omitted value as true."}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "pause"}}, "required": ["operation"]},
          "then": {"properties": {"from_state": {"const": "active"}, "to_state": {"const": "paused"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "retire"}}, "required": ["operation"]},
          "then": {"properties": {"from_state": {"not": {"const": "retired"}}, "to_state": {"const": "retired"}}}
        },
        {
          "if": {"properties": {"operation": {"enum": ["validate", "plan", "apply", "verify"]}}, "required": ["operation"]},
          "then": {
            "anyOf": [
              {"properties": {"from_state": {"const": "proposed"}, "to_state": {"const": "sandbox"}}},
              {"properties": {"from_state": {"const": "sandbox"}, "to_state": {"const": "evaluated"}}},
              {"properties": {"from_state": {"const": "evaluated"}, "to_state": {"const": "pilot"}}},
              {"properties": {"from_state": {"const": "pilot"}, "to_state": {"const": "active"}}},
              {"properties": {"from_state": {"const": "paused"}, "to_state": {"const": "active"}}}
            ]
          }
        }
      ]
    }
  }
}
